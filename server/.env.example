# Server environment variables — copy to .env and fill in real values
# NEVER commit .env to version control.

# VLM provider (Gemini Flash by default)
VLM_API_KEY=your_gemini_api_key_here
VLM_BASE_URL=https://generativelanguage.googleapis.com
VLM_MODEL=gemini-1.5-flash-8b

# Server
PORT=3000

# CORS — comma-separated origins allowed to call the API
# chrome-extension://* is the extension's origin
CORS_ORIGINS=chrome-extension://,moz-extension://,http://localhost:5173
