{
  "manifest_version": 3,
  "name": "SIH26171 — Privacy Browser Agent",
  "version": "0.1.0",
  "description": "On-device visual perception with local PII redaction before sending sanitized context to a VLM agent.",

  "permissions": [
    "tabs",
    "activeTab",
    "scripting",
    "storage"
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["dist/content.js"],
      "run_at": "document_idle"
    }
  ],

  "action": {
    "default_popup": "popup.html",
    "default_title": "Browser Agent"
  },

  "web_accessible_resources": [
    {
      "resources": [
        "wasm/*.wasm",
        "wasm/*.js",
        "models/*"
      ],
      "matches": ["<all_urls>"]
    }
  ],

  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  }
}
